# ─────────────────────────────────────────────────────────────────────────────
# FlowClip — Docker runtime environment variables
#
# HOW TO USE
#   cp .env.docker.example .env.docker
#   # fill in every value marked <required>
#   docker compose up --build
#
# RULES
#   • .env.docker is in .gitignore — never commit it
#   • NEXT_PUBLIC_* vars must ALSO be passed as --build-arg at build time
#     (they are baked into the client JS bundle by next build, not read at runtime)
#     docker compose handles this automatically via the `args:` block in docker-compose.yml
# ─────────────────────────────────────────────────────────────────────────────


# ── Chrome extension ID ───────────────────────────────────────────────────────
# The unpacked extension's ID from chrome://extensions
# Used by the web app to validate postMessage origins from the extension
# Also required as a build arg (see docker-compose.yml args section)
NEXT_PUBLIC_EXTENSION_ID=<your-extension-id>          # <required>


# ── Database ──────────────────────────────────────────────────────────────────
# Pooled connection — used by the Next.js app for all queries
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require   # <required>

# Unpooled connection — used by drizzle-kit CLI for migrations (not needed at runtime)
# Leave blank if you only run migrations outside the container
DATABASE_URL_UNPOOLED=


# ── Google Gemini ─────────────────────────────────────────────────────────────
# Used to generate text-embedding-004 vectors for semantic search
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key>                  # <required>


# ── Admin ─────────────────────────────────────────────────────────────────────
# Protects the internal /api/search-bench cache-flush route
# Use a strong random string — e.g.: openssl rand -hex 32
ADMIN_SECRET=<strong-random-secret>                   # <required>


# ── S3-compatible object storage (Neon Storage / AWS S3) ─────────────────────
# Used for image clip uploads via presigned URLs
# Endpoint: your S3-compatible storage base URL (leave blank to use AWS default)
AWS_ENDPOINT_URL_S3=https://<your-storage-endpoint>   # optional — omit for real AWS S3

AWS_ACCESS_KEY_ID=<your-access-key-id>                # <required>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>        # <required>

# AWS region where your bucket lives
AWS_REGION=ap-southeast-1                             # <required>
