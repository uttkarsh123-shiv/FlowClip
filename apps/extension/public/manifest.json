{
  "manifest_version": 3,
  "name": "FlowClip",
  "version": "1.0.0",
  "description": "Smart clipboard manager",
  "permissions": ["clipboardRead", "storage", "activeTab"],
  "background": {
    "service_worker": "background/index.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
