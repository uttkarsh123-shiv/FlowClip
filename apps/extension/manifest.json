{
  "manifest_version": 3,
  "name": "FlowClip",
  "version": "1.0.0",
  "description": "Smart clipboard manager",
  "permissions": ["clipboardRead", "storage", "activeTab"],
  "host_permissions": ["https://fantastic-condor-84.eu-west-1.convex.site/*"],
  "background": {
    "service_worker": "src/background/index.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.js"]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  }
}
